# Copie ce fichier sous config/.env sur o2switch, puis remplace chaque valeur.
# config/.env est ignoré par Git et bloqué par les règles Apache ; ne le dépose jamais
# dans un dossier public sans la protection fournie par ce projet.

# Application
APP_ENV=production
APP_URL=https://cxrilwebs.fr

# Réception des formulaires et SMTP o2switch
CONTACT_TO_EMAIL=contact@cxrilwebs.fr
MAIL_FROM_EMAIL=contact@cxrilwebs.fr
MAIL_FROM_NAME=CxrilWebs
SMTP_HOST=mail.cxrilwebs.fr
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=contact@cxrilwebs.fr
SMTP_PASSWORD=change-moi

# Supabase — optionnel mais nécessaire pour conserver la synchronisation avec l'administration
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ... # Clé service_role : secret côté serveur uniquement

# Stripe — secret côté serveur uniquement
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optionnel mais recommandé : identifiants Price Stripe correspondant exactement
# aux offres du catalogue de api/create-checkout-session.php.
STRIPE_PRICE_WEB_EXPRESS_DEPOSIT=
STRIPE_PRICE_WEB_VITRINE_DEPOSIT=
STRIPE_PRICE_WEB_ECOMMERCE_DEPOSIT=
STRIPE_PRICE_MAINTENANCE_ONESHOT=
STRIPE_PRICE_MAINTENANCE_MONTHLY=
STRIPE_PRICE_MAINTENANCE_YEARLY=
STRIPE_PRICE_SOCIAL_BASIC_MONTHLY=
STRIPE_PRICE_SOCIAL_PLUS_MONTHLY=
STRIPE_PRICE_SOCIAL_FACEBOOK=
STRIPE_PRICE_SOCIAL_INSTAGRAM=
STRIPE_PRICE_SOCIAL_TIKTOK=
STRIPE_PRICE_SOCIAL_LINKEDIN=
