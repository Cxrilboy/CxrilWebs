# ============================================================================
# SUPABASE — Configuration
# ============================================================================
# Copie ce fichier en .env et remplis tes valeurs depuis Supabase
# Ne jamais committer .env (déjà dans .gitignore)

# URL de ton projet Supabase (trouvé dans Settings → API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Clé Anon (publique — safe à mettre en frontside)
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# ============================================================================
# NETLIFY — Variables de déploiement
# ============================================================================
# Ajoute ces mêmes valeurs dans:
# Netlify Dashboard → Settings → Build & Deploy → Environment variables
# Puis redéploie pour que les changements prennent effet
